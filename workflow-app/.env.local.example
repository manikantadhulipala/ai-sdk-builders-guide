RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxx
# Neon Postgres connection string for the order store. Get it from Vercel:
# look-in → pizza-tracker → Storage → your Neon database → copy DATABASE_URL.
# It is a Secret, so `vercel env pull` cannot download it.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional. Needs a domain verified at resend.com/domains, to email customers other than the account owner.
# RESEND_FROM="Sal's Pizza <orders@your-verified-domain.com>"
# Optional for local dev: keeps run history for the local dashboard (`pnpm dashboard`).
# WORKFLOW_TARGET_WORLD=local
# WORKFLOW_LOCAL_DATA_DIR=.workflow-data
